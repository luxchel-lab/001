<?php
/**
 * ArchiColor AI — локальная конфигурация.
 *
 * Скопируйте в config.local.php и заполните. Файл не попадает в git:
 * в нём лежит ключ Decor8.ai.
 *
 * Всё, чего здесь нет, берётся из значений по умолчанию (Config::defaults()).
 * Ключ можно задать и переменной окружения DECOR8AI_API_KEY — тогда этот файл
 * не нужен вовсе; так безопаснее.
 */

return array(
    /* Обязательное */
    'decor8_api_key'   => 'sk-…',                 // ключ из личного кабинета Decor8.ai
    'public_base_url'  => 'https://archipaint.ru', // домен сайта, виден из интернета

    /* Как передавать фото в Decor8: 'auto' | 'url' | 'multipart' */
    'decor8_input_mode' => 'auto',

    /* База: пусто — реквизиты берутся из настроек Bitrix */
    'db_dsn'      => '',          // 'mysql:host=localhost;dbname=sitedb;charset=utf8mb4'
    'db_user'     => '',
    'db_password' => '',

    /* Лимиты и баллы */
    'free_per_day'     => 3,      // бесплатных примерок в сутки
    'timezone'         => 'Europe/Moscow',
    'price_points'     => 20,     // баллов за примерку сверх лимита
    'points_per_rub'   => 1,      // 1 ₽ пополнения = 1 балл
    'rub_per_cashback_point' => 1000,   // 1000 ₽ заказа = 1 балл
    'rate_limit_per_hour' => 20,  // потолок на один IP

    /**
     * Отправка SMS с кодом входа. Без этого хука код пишется в лог,
     * а не уходит клиенту, — на боевом сайте так оставлять нельзя.
     *
     * 'sms_sender' => function ($phone, $text) {
     *     return MySmsGate::send($phone, $text);   // true, если шлюз принял
     * },
     */

    /* ЮKassa: баллы начисляются только по вебхуку payment.succeeded */
    'yookassa_shop_id'    => '',
    'yookassa_secret_key' => '',
    'yookassa_payment_method' => 'sbp',
    'yookassa_return_url' => '/personal/balance/',

    /* Секрет для POST /api/archicolor/cashback; пусто — эндпоинт выключен */
    'cashback_secret' => '',

    /* Хранилище */
    'keep_files_days'  => 14,     // через сколько дней удалять картинки

    /**
     * Перевод задания клиента на английский. Decor8 построен на модели
     * с англоязычным энкодером, поэтому перевод заметно улучшает результат.
     *
     * 'prompt_translator' => function ($russianText) {
     *     return MyTranslator::toEnglish($russianText);
     * },
     */

    /* Диагностика: true — текст ошибки провайдера уходит в ответ API.
       На боевом сайте держите false. */
    'debug' => false,
);
